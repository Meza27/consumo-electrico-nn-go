    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Responde en menos de 100 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(100); });",
                  "const j = pm.response.json();",
                  "pm.test(\"Devuelve un JWT\", function () { pm.expect(j.token.split(\".\").length).to.eql(3); });",
                  "pm.collectionVariables.set(\"token\", j.token);"
                ]
              }
            }
          ]
        },
