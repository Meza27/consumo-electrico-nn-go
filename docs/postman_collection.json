{
  "info": {
    "name": "TF CC65 – API Consumo Eléctrico (Grupo 10, PC4)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pruebas de la API coordinadora. Ejecutar primero 'Login admin' (guarda el token en la variable {{token}}). Requisito: latencia < 100 ms."
  },
